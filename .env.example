# 复制本文件为 pipeline/.env 后填写。真实 .env 已被 .gitignore，不会入库。
# 引擎选择：本地 Ollama 优先，DeepSeek 兜底（见 pipeline/llm.py 的 pick_backend）。
# 二选一即可跑通：① 配好本地 Ollama（无需任何 key）；② 填 DEEPSEEK_API_KEY。

# —— 云端兜底引擎（DeepSeek，OpenAI 兼容）——
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：覆盖云端模型名（默认 deepseek-chat）
# INTEL_CLOUD_MODEL=deepseek-chat

# —— 本地优先引擎（可选，拉好 ollama 模型后自动检测）——
# OLLAMA_HOST=http://localhost:11434
# INTEL_LOCAL_MODEL=qwen2.5:7b

# —— 可选：仅"播客转录/配音"脚本使用（reprocess_full.py 等）——
# FFMPEG=/usr/local/bin/ffmpeg
# FFPROBE=/usr/local/bin/ffprobe
# INTEL_PROXY=http://127.0.0.1:18080
